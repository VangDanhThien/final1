<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Final Exam</title>

    <style>
        body {
            margin: 0;
            font-family: "Times New Roman",Times,serif;
            background: #f5f5f5;
        }

        header {
            background: #c62828;
            color: aliceblue;
            text-align: center;
            padding: 25px;
            font-size: 26px;
            font-weight: bold;
        }

        subheader {
            display: block;
            background: linear-gradient(to right,#99CCFF,#33CCFF,#99CCFF);
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 18px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

        .container {
            margin: 20px;
        }

        main {
            background: white;
            padding: 15px;
        }

        aside {
            background: #eee;
            padding: 15px;
        }

        footer {
            background: #c62828;
            color: white;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>

<body>

    <header>FINAL EXAM FOR DISCRETE STRUCTURE</header>

    <subheader>
        <p>Thành Viên Nhóm:</p>
        <p>Trương Hoàng Đăng Khoa</p>
        <p>Nguyễn Nhật Trường</p>
        <p>Đặng Thái Lâm Đức</p>
        <p>Trần Phạm Hoài Nam</p>
        <p>Phạm Nguyễn Đức Thịnh</p>
    </subheader>

    <div class="container">
        <main>
            <h2>Nội dung chính</h2>
            <p>Chỗ này chèn nội dung</p>
        </main>

        <aside>
            <h3>Sidebar</h3>
            <p>Biểu đồ hoặc mô tả</p>
        </aside>
    </div>

    <footer>

        <canvas id="ab" width="1000" height="600"
                style="border:1px solid #000;display:block;margin:20px auto;"></canvas>

        <div style="text-align:center">
            <button onclick="aa()">Thêm đỉnh</button>
            <button onclick="ac()">Xóa đỉnh</button>
            <button onclick="ae()">Thêm cạnh</button>
            <button onclick="ag()">Xóa cạnh</button><br><br>

            <label>Trọng số:</label>
            <input type="number" id="ai" value="1" style="width:60px">

            <label>Hướng:</label>
            <select id="aj">
                <option value="d">Có hướng</option>
                <option value="u">Vô hướng</option>
            </select>
        </div>

        <div style="width:80%;margin:auto;background:#fff;padding:15px">
            <h3>Adjacency List</h3>
<pre id="ak">Đang cập nhật...</pre>
        </div>

        <script>
            let al=[];
            let am=[];

            function aa(){
                let an=al.length+1;
                al.push({i:an,x:100+an*80,y:250});
                az();
            }

            function ac(){
                if(al.length>0){
                    let ao=al.pop();
                    am=am.filter(p=>p.f!==ao.i&&p.t!==ao.i);
                    az();
                }
            }

            function ae(){
                if(al.length>=2){
                    let ap=parseInt(document.getElementById("ai").value);
                    let aq=document.getElementById("aj").value;
                    am.push({
                        f:al[al.length-2].i,
                        t:al[al.length-1].i,
                        w:ap,
                        d:aq
                    });
                    az();
                }
            }

            function ag(){
                if(am.length>0){
                    am.pop();
                    az();
                }
            }

            function az(){
                let ar=document.getElementById("ab");
                let as=ar.getContext("2d");
                as.clearRect(0,0,ar.width,ar.height);

                am.forEach(e=>{
                    let at=al.find(v=>v.i===e.f);
                    let au=al.find(v=>v.i===e.t);
                    if(at&&au){
                        as.beginPath();
                        as.moveTo(at.x,at.y);
                        as.lineTo(au.x,au.y);
                        as.stroke();

                        as.fillText(e.w,(at.x+au.x)/2,(at.y+au.y)/2);

                        if(e.d==="d"){
                            let av=Math.atan2(au.y-at.y,au.x-at.x);
                            let aw=au.x-10*Math.cos(av);
                            let ax=au.y-10*Math.sin(av);
                            as.beginPath();
                            as.moveTo(aw,ax);
                            as.lineTo(aw-5*Math.cos(av-Math.PI/6),ax-5*Math.sin(av-Math.PI/6));
                            as.lineTo(aw-5*Math.cos(av+Math.PI/6),ax-5*Math.sin(av+Math.PI/6));
                            as.fill();
                        }
                    }
                });

                al.forEach(n=>{
                    as.beginPath();
                    as.arc(n.x,n.y,20,0,2*Math.PI);
                    as.fillStyle="#4caf50";
                    as.fill();
                    as.stroke();
                    as.fillStyle="white";
                    as.fillText(n.i,n.x-5,n.y+5);
                });

                let ay={};
                al.forEach(n=>ay[n.i]=[]);
                am.forEach(e=>{
                    ay[e.f].push(e.t+"("+e.w+")");
                    if(e.d==="u") ay[e.t].push(e.f+"("+e.w+")");
                });

                let azz="";
                for(let k in ay){
                    azz+=k+": "+ay[k].join(", ")+"\n";
                }
                document.getElementById("ak").textContent=azz;
            }
        </script>

    </footer>
</body>
</html>
